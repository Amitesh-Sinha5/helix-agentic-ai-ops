# Vite inlines VITE_* variables at build time, so changing this requires a
# rebuild, not just a restart.

# The URL the browser calls. In Docker this is the published host port, never
# the compose service name.
VITE_API_URL=http://localhost:8000

# Used by `npm run test:e2e` to point Playwright at running servers.
# Dedicated ports so E2E never collides with the dev servers or docker compose.
# E2E_API_URL=http://127.0.0.1:8100
# E2E_BASE_URL=http://127.0.0.1:4174
