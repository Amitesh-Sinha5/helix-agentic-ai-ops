# Copy to .env and adjust. Every value here has a working default in
# app/config.py, so an empty .env still boots.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# --- LLM ---------------------------------------------------------------------
# mock = deterministic, offline, zero-cost. Used by tests and CI.
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Any OpenAI-compatible server works via OPENAI_BASE_URL -- that is how you run
# Helix for free, either locally or on a hosted free tier. No key is required
# when a base URL is set, because local servers ignore it.
#
#   Ollama (local, free, no signup):
#     LLM_PROVIDER=openai
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_MODEL=qwen2.5:7b-instruct
#
#   Groq / OpenRouter / Together / LM Studio / vLLM: same pattern, swap the URL
#   and supply that service's key as OPENAI_API_KEY.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Cost accounting, USD per 1k tokens — set these to your model's real prices or
# the numbers on /observability/summary will be fiction.
COST_PER_1K_PROMPT_TOKENS=0.003
COST_PER_1K_COMPLETION_TOKENS=0.015

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./helix.db
# DATABASE_URL=postgresql+asyncpg://helix:helix@localhost:5432/helix

# --- Redis -------------------------------------------------------------------
# Unreachable Redis falls back to an in-process fake unless REDIS_REQUIRED=true.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# --- Auth --------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
FREE_TIER_DAILY_REQUESTS=20
PRO_TIER_DAILY_REQUESTS=-1

# --- Semantic cache ----------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.93

# --- RAG ---------------------------------------------------------------------
CHROMA_PERSIST_DIR=./.chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4
MAX_RETRIEVAL_LOOPS=2
MIN_RETRIEVAL_SCORE=0.15
# Needs `pip install -r requirements-rerank.txt` (pulls in torch).
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Support triage ----------------------------------------------------------
CLASSIFIER_PATH=app/support/classifier.pkl
# Below this confidence the trained model defers to the LLM classifier.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.55

# --- Billing (Stripe test mode) ----------------------------------------------
# Leave blank to run simulated checkout (no Stripe account needed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=price_helix_pro_test
BILLING_SUCCESS_URL=http://localhost:5173/billing?status=success
BILLING_CANCEL_URL=http://localhost:5173/billing?status=cancelled

# --- Quality gate ------------------------------------------------------------
QUALITY_MIN_FAITHFULNESS=0.70
QUALITY_MIN_ANSWER_RELEVANCE=0.70
QUALITY_MIN_CONTEXT_PRECISION=0.60

# --- CORS --------------------------------------------------------------------
# Comma-separated, or a JSON array. Lock this down in production.
CORS_ORIGINS=http://localhost:5173
